# Public site URL (canonical, sitemap, Open Graph, links in emails). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.rainmakers.it

# Supabase "Rainmakers OS" — server-side only. NEVER prefix these with NEXT_PUBLIC_.
# Every form writes here (migrations 0001–0010; the CRM is 0010_crm.sql). docs/crm/README.md explains the setup.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Calls the SECURITY DEFINER functions (crm_submit, crm_newsletter_*) and uploads pitch decks / CVs to the private
# "join-documents" bucket (service_role or sb_secret_… key).
SUPABASE_SERVICE_ROLE_KEY=
# Reads public communities (anon or sb_publishable_… key). Falls back to the service key if empty.
SUPABASE_ANON_KEY=

# Brevo (server-side only) — transactional emails only: newsletter double opt-in, welcome, acknowledgements and the
# team notifications. API key: Brevo → SMTP & API → API keys. Sender address must be verified (authenticated domain).
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Rainmakers
BREVO_REPLY_TO=
# Internal notifications (optional overrides). Every "Come vuoi iniziare?" request is emailed to JOIN_NOTIFY_EMAIL
# (default info@rainmakers.it, reply-to = the visitor, PDF attached); reviews to FORMS_NOTIFY_EMAIL (default
# tools@nuvolab.com); every confirmed newsletter subscription to NEWSLETTER_NOTIFY_EMAIL (default tools@nuvolab.com).
# JOIN_NOTIFY_EMAIL=info@rainmakers.it
# FORMS_NOTIFY_EMAIL=tools@nuvolab.com
# NEWSLETTER_NOTIFY_EMAIL=tools@nuvolab.com

# Signs the personal unsubscribe links of "Gocce di Innovazione" (HMAC). Required in production: at least 32 random
# characters (e.g. `openssl rand -base64 48`). Changing it invalidates the links already sent.
NEWSLETTER_LINK_SECRET=

# Random secret for the daily retry job (/api/cron/brevo-retry); Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Optional: max upload size in MB for pitch decks and CVs (PDF only). Capped at 4; default 4.
# JOIN_UPLOAD_MAX_MB=4

# Optional: accept submissions without Supabase in a production build (staging demo). Logs only,
# nothing is stored — never set this in production.
# LEADS_MOCK=1

# ─── Future syncs (PREPARED, OFF) — docs/crm/README.md → "Attivare le sincronizzazioni" ───
# Nothing is sent to Brevo lists or Airtable until the switch is "1" AND the credentials are set.
# CRM_SYNC_BREVO_ENABLED=1
# Numeric id of the Brevo list "RM | Newsletter | Gocce di Innovazione" (only confirmed subscribers go there)
# BREVO_GDI_LIST_ID=
# Shared secret in the Brevo webhook URL (/api/webhooks/brevo?secret=…) for unsubscribes Brevo → Supabase
# BREVO_WEBHOOK_SECRET=
# CRM_SYNC_AIRTABLE_ENABLED=1
# Airtable base "Rainmakers OS | CRM" (personal access token with read/write on that base, and its id appXXXXXXXX)
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=

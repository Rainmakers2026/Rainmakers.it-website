# Public site URL (canonical, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.rainmakers.it

# Supabase — server-side only. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: accept leads without Supabase in a production build (e.g. staging demo). Logs only.
# LEADS_MOCK=1

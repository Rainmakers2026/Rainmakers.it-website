# Public site URL (canonical, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.rainmakers.it

# Supabase — server-side only. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Writes leads through submit_lead() (service_role or sb_secret_… key)
SUPABASE_SERVICE_ROLE_KEY=
# Reads public communities (anon or sb_publishable_… key). Falls back to the service key if empty.
SUPABASE_ANON_KEY=

# Optional: accept leads without Supabase in a production build (staging demo). Logs only.
# LEADS_MOCK=1

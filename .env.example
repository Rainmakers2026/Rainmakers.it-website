# Public site URL (canonical, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.rainmakers.it

# Supabase — server-side only. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Writes form submissions (submit_contact / submit_join_application / submit_community_request) and
# uploads Join files to the private "join-documents" bucket (service_role or sb_secret_… key).
SUPABASE_SERVICE_ROLE_KEY=
# Reads public communities (anon or sb_publishable_… key). Falls back to the service key if empty.
SUPABASE_ANON_KEY=

# Brevo (server-side only) — newsletter double opt-in, list sync and transactional emails.
# API key: Brevo → SMTP & API → API keys. Sender address must be verified (ideally on an authenticated domain).
BREVO_API_KEY=
# Numeric id of the Brevo list named "Contatti" (Contacts → Lists). Only confirmed subscribers are added.
BREVO_CONTACTS_LIST_ID=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Rainmakers
BREVO_REPLY_TO=

# Random secret for the daily retry job (/api/cron/brevo-retry); Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Optional: max Join the Tribe upload size in MB (PDF only). Capped at 4; default 4.
# JOIN_UPLOAD_MAX_MB=4

# Optional: accept submissions without Supabase in a production build (staging demo). Logs only,
# nothing is stored — never set this in production.
# LEADS_MOCK=1

# Optional Airtable mirror for Join forms. Create separate tables with the expected
# field names documented in README.md before enabling these values.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_PITCH_TABLE_ID=
AIRTABLE_CV_TABLE_ID=

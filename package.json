{
  "name": "rainmakers-web",
  "version": "2.0.0",
  "private": true,
  "description": "Rainmakers.it — one-page lead generation site (IT/EN), Next.js + Supabase + Vercel",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-content.ts",
    "copy:export": "tsx scripts/export-copy.ts > docs/03-copy-deck.md",
    "test": "tsx scripts/test-validation.ts && npm run -s test:api && npm run -s test:brevo && npm run -s test:crm && npm run -s test:annotations && tsx scripts/check-content.ts && tsx scripts/check-placeholders.ts",
    "test:api": "tsx --conditions=react-server scripts/test-api.ts",
    "test:brevo": "tsx --conditions=react-server scripts/test-brevo.ts",
    "test:annotations": "tsx --conditions=react-server scripts/test-annotations.ts",
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "count:words": "tsx --tsconfig scripts/tsconfig.json scripts/count-words.ts",
    "test:crm": "tsx --conditions=react-server scripts/test-crm.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "next": "^15.5.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
